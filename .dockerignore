uploads/
downloads/
.cache/
vector_db/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/

# Git
.git/
.gitignore
.gitattributes

# Logs
logs/
*.log
*.tmp

# Misc
