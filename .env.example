GROQ_API_KEY=replace_with_your_groq_key
SARVAM_API_KEY=replace_with_your_sarvam_key

# Optional
GROQ_MODEL=llama-3.1-8b-instant
WHISPER_MODEL=small
SARVAM_STT_MODEL=saaras:v2.5

# Optional: only needed for visual frame analysis; model availability may vary by account
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Local FastAPI job, upload, rate and retention limits
VIDEO_JOB_WORKERS=1
MAX_OUTSTANDING_JOBS=3
MAX_UPLOAD_MB=512
MAX_MEDIA_HOURS=6
JOB_HOURLY_LIMIT=5
CHAT_PER_MINUTE_LIMIT=15
JOB_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=7
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
